{
  "name": "bochur-bros",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Bochur Bros - a 2D side-scrolling platformer",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && npm run check:maps && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "build:playtest": "npm run build && node scripts/build-playtest.mjs",
    "build:maps": "node tools/make-maps.mjs",
    "check:maps": "node tools/check-maps.mjs"
  },
  "dependencies": {
    "phaser": "^3.90.0"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  }
}
