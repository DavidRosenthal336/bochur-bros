{
  "name": "bochur-bros",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Bochur Bros - a 2D side-scrolling platformer",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && npm run check:art && npm run build:maps && npm run check:maps && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "build:playtest": "npm run build && node scripts/build-playtest.mjs",
    "build:maps": "node tools/make-maps.mjs",
    "check:maps": "node tools/check-maps.mjs",
    "check:art": "node tools/check-art.mjs",
    "art": "python3 tools/art/generate.py --out public/sprites",
    "art:scenery": "python3 tools/art/scenery.py --out public/sprites",
    "art:icon": "python3 tools/art/icon.py"
  },
  "dependencies": {
    "phaser": "^3.90.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  }
}
